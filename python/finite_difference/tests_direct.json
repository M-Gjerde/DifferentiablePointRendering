{
  "schema_version": 2,
  "description": "Progressive deterministic direct point-light adjoint finite-difference suite.",
  "defaults": {
    "scene": "fd_direct",
    "camera": "camera",
    "objective": {
      "type": "linear",
      "channel_weights": [1.0, -0.65, 0.35]
    },
    "epsilons": [0.001, 0.0003],
    "settings": {
      "photons": 1,
      "bounces": 1,
      "forward_passes": 1,
      "primal_shadow_rays": 1,
      "adjoint_shadow_rays": 1,
      "gather_passes": 1,
      "adjoint_bounces": 1,
      "adjoint_passes": 8,
      "logging": 4,
      "seed": 42,
      "enable_adjoint_shadow_rays": true,
      "adjoint_shadow_path_rays": 1,
      "adjoint_q_null": 0.0,
      "adjoint_q_reflect": 1.0,
      "share_local_layer_direct_lighting": false,
      "local_layer_depth_epsilon": 0.02,
      "local_layer_normal_cosine_threshold": 0.5,
      "max_splat_events_per_ray": 8,
      "max_local_surfel_hits": 8,
      "point_hit_batch_size": 6,
      "point_hit_batch_lookahead": true
