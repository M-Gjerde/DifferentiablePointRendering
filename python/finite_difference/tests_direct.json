    "check": {
      "relative_tolerance": 0.06,
      "absolute_tolerance": 5e-7,
      "minimum_signal": 2e-6,
      "fd_consistency_relative_tolerance": 0.08,
      "repeatability_tolerance": 0.0,
      "allow_zero_signal": false
